### Input configuration Read `man 5 sway-input` for more information about this section. Touchpad configuration
input "type:touchpad" {
  dwt enabled
tap enabled
natural_scroll enabled
}
# Disable numlock by default
input type:keyboard xkb_numlock disabled

input "type:keyboard" {
    xkb_layout "fr"
    xkb_variant "us"
    xkb_options "caps:swapescape"
}
